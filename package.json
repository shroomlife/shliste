{
  "name": "shliste.app",
  "version": "0.9.4",
  "private": false,
  "keywords": [
    "nuxt",
    "docker",
    "vue",
    "lists",
    "recipes",
    "shopping"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shroomlife/shliste.git"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "docker:build": "docker build -t shroomlife/shliste:latest .",
    "docker:push": "docker push shroomlife/shliste:latest",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "pb": "docker build -t shroomlife/shliste:latest . && docker push shroomlife/shliste:latest",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxtjs/seo": "3.2.2",
    "@pinia/nuxt": "0.11.2",
    "cheerio": "1.1.2",
    "googleapis": "160.0.0",
    "lodash-es": "4.17.21",
    "moment": "2.30.1",
    "nuxt": "4.1.2",
    "openai": "5.22.0",
    "sweetalert2": "11.23.0",
    "uuid": "13.0.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.9.0",
    "@nuxt/kit": "4.1.2",
    "@nuxt/ui": "^2",
    "@types/cheerio": "1.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/uuid": "11.0.0",
    "eslint": "9.36.0",
    "sass": "1.93.0",
    "tailwindcss": "^3",
    "typescript": "5.9.2",
    "vite-svg-loader": "5.1.0",
    "vue": "3.5.21",
    "vue-tsc": "3.0.7"
